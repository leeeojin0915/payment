<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    PaymentMapper XML
    PaymentMapper 인터페이스의 실제 SQL 구현
    namespace는 매퍼 인터페이스 전체 경로와 일치해야 함
-->
<mapper namespace="org.study.paymentcommon.mapper.PaymentMapper">
    <!-- 트랜잭션 ID로 단건 조회 -->
    <select id="findByTransactionId" resultType="PaymentTransaction">
        SELECT * FROM payment_transactions
        WHERE transaction_id = #{transactionId}
    </select>

    <!-- 주문 ID로 단건 조회 -->
    <select id="findByOrderId" resultType="PaymentTransaction">
        SELECT * FROM payment_transactions
        WHERE order_id = #{orderId}
    </select>

    <!-- 전체 결제 내역 최신순 조회 -->
    <select id="findAll" resultType="PaymentTransaction">
        SELECT * FROM payment_transactions
        ORDER BY requested_at DESC
    </select>

</mapper>